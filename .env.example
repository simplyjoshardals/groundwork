# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.
#
# Local development: run `yarn supabase start`, then `yarn supabase status`
# and paste the API URL and keys it prints. Hosted values go in Vercel only.

# Supabase API URL. Local default shown.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Safe for the browser (protected by RLS). Called "Publishable key" (sb_publishable_...)
# in current Supabase, or "anon key" on older projects/CLIs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never import in client code.
# Called "Secret key" (sb_secret_...) in current Supabase, or "service_role key" on older ones.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key for the CAPTCHA on sign-in, sign-up and "Try demo".
# Public by design. The Turnstile SECRET key is never stored in the app: Supabase Auth
# holds it (dashboard for the hosted project, supabase/config.toml locally).
# Local development and Playwright: keep this Cloudflare always-pass TEST key; it pairs with
# the test secret in supabase/config.toml. Hosted (Vercel only): your real site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# SERVER ONLY. Google AI Studio key for embeddings and the answer LLM. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Overrides the default Gemini LLM model id (see lib/providers/gemini-llm.ts).
# GEMINI_LLM_MODEL=
