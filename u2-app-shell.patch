+      description: `No questions left today. Resets at ${reset}.`,
+      empty: true,
+    };
+  }
+  return {
+    label: `${usage.remaining} of ${usage.dailyLimit} left`,
+    description: `${usage.remaining} of ${usage.dailyLimit} questions left today. Resets at ${reset}.`,
+    empty: false,
+  };
+}
