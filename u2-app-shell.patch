diff --git a/lib/theme/apply-theme.ts b/lib/theme/apply-theme.ts
new file mode 100644
index 0000000..6547316
--- /dev/null
+++ b/lib/theme/apply-theme.ts
@@ -0,0 +1,90 @@
+import {
+  THEME_CHOICES,
+  THEME_STORAGE_KEY,
+  type ThemeChoice,
+} from "./theme-script";
+
+/** Same-tab change signal (the `storage` event only fires in other tabs). */
+const CHANGE_EVENT = "groundwork-theme-change";
+const DARK_QUERY = "(prefers-color-scheme: dark)";
+
+function isThemeChoice(value: unknown): value is ThemeChoice {
+  return THEME_CHOICES.some((c) => c === value);
+}
+
+/** The stored choice; `system` when nothing usable is stored or storage is blocked. */
+export function readThemeChoice(): ThemeChoice {
+  try {
+    const stored = localStorage.getItem(THEME_STORAGE_KEY);
+    return isThemeChoice(stored) ? stored : "system";
+  } catch {
+    return "system";
+  }
+}
+
+/** Sets `data-theme` the way the head script does: always light or dark. */
+export function applyThemeChoice(choice: ThemeChoice): void {
+  let dark = choice === "dark";
+  if (choice === "system") {
+    try {
+      dark = matchMedia(DARK_QUERY).matches;
+    } catch {
+      dark = false;
+    }
+  }
+  document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
+}
+
+/** Stores and applies a choice, and tells subscribers in this tab. */
+export function setThemeChoice(choice: ThemeChoice): void {
+  try {
+    localStorage.setItem(THEME_STORAGE_KEY, choice);
+  } catch {
+    // Storage blocked: the change still applies for this page view.
+  }
+  applyThemeChoice(choice);
+  window.dispatchEvent(new Event(CHANGE_EVENT));
+}
+
+/** System, then Light, then Dark, then back to System. */
+export function nextThemeChoice(choice: ThemeChoice): ThemeChoice {
+  if (choice === "system") return "light";
+  if (choice === "light") return "dark";
+  return "system";
+}
+
+/**
+ * For `useSyncExternalStore`. Notifies on a change in this tab or another, and
+ * re-applies the theme when the OS preference flips while the choice is
+ * `system` (the head script only runs once, at load).
+ */
+export function subscribeToTheme(onChange: () => void): () => void {
+  let media: MediaQueryList | null = null;
+  try {
+    media = matchMedia(DARK_QUERY);
+  } catch {
+    media = null;
+  }
+  const onOsChange = () => {
+    if (readThemeChoice() === "system") applyThemeChoice("system");
+  };
+  const onStorage = (event: StorageEvent) => {
+    if (event.key !== null && event.key !== THEME_STORAGE_KEY) return;
+    applyThemeChoice(readThemeChoice());
+    onChange();
+  };
+  media?.addEventListener("change", onOsChange);
+  window.addEventListener("storage", onStorage);
+  window.addEventListener(CHANGE_EVENT, onChange);
+  return () => {
+    media?.removeEventListener("change", onOsChange);
+    window.removeEventListener("storage", onStorage);
+    window.removeEventListener(CHANGE_EVENT, onChange);
+  };
+}
+
+export const THEME_LABEL: Record<ThemeChoice, string> = {
+  system: "System",
+  light: "Light",
+  dark: "Dark",
+};
diff --git a/supabase/migrations/20261112120000_peek_usage.sql b/supabase/migrations/20261112120000_peek_usage.sql
new file mode 100644
index 0000000..9f00c70
--- /dev/null
+++ b/supabase/migrations/20261112120000_peek_usage.sql
@@ -0,0 +1,46 @@
+-- Read-only counterpart of consume_usage, for the app header's question counter (U2).
+-- Reports how much of today's allowance a user has spent WITHOUT spending a unit and without
+-- writing any row. Service-role only, like consume_usage: the usage tables stay unreadable to clients.
+-- It ignores the cooldown and the global cap on purpose: the counter shows the user's own budget.
+-- Returns no row for an unknown user.
+create or replace function public.peek_usage(p_user_id uuid, p_kind text)
+returns table (used_today integer, daily_limit integer, resets_at timestamptz)
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  v_day     date        := (now() at time zone 'utc')::date;
+  v_reset   timestamptz := ((v_day + 1)::timestamp at time zone 'utc');
+  v_is_anon boolean;
+  v_limit   integer;
+  v_used    integer;
+begin
+  if p_kind not in ('question', 'ingest') then
+    raise exception 'unknown usage kind: %', p_kind;
+  end if;
+
+  select coalesce(u.is_anonymous, false) into v_is_anon from auth.users u where u.id = p_user_id;
+  if not found then
+    return;
+  end if;
+
+  if v_is_anon then
+    v_limit := private.cfg('limit_anon_' || p_kind)::integer;
+  else
+    v_limit := private.cfg('limit_user_' || p_kind)::integer;
+  end if;
+
+  select coalesce(
+           (select ud.used from public.usage_daily ud
+             where ud.user_id = p_user_id and ud.day = v_day and ud.kind = p_kind),
+           0)
+    into v_used;
+
+  return query select v_used, greatest(v_limit, 0), v_reset;
+end;
+$$;
+
+revoke all on function public.peek_usage(uuid, text) from public, anon, authenticated;
+grant execute on function public.peek_usage(uuid, text) to service_role;
