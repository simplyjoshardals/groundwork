{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "seed:samples": "tsx --conditions=react-server --env-file=.env.local scripts/seed-samples.ts",
    "eval:validate": "tsx eval/validate-dataset.ts",
    "provider:smoke": "tsx --conditions=react-server --env-file=.env.local scripts/provider-smoke.ts",
    "spike:provider": "tsx --env-file=.env.local spikes/provider/run.ts",
    "spike:pdf": "tsx --env-file=.env.local spikes/pdf/run.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "11.0.0",
    "server-only": "0.0.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.12.0"
}
