<file path="lib/providers/errors.ts">
/**
 * Provider-agnostic error types (Task 1.3).
 *
 * Messages are built here from a status and short enum-like codes only. They
 * never contain a raw provider response body, request text, or credentials,
 * so they are safe to log. Callers decide what (if anything) reaches a user.
 */

export type ProviderName = "gemini";

const PROVIDER_LABEL: Record<ProviderName, string> = { gemini: "Gemini" };

export interface ProviderErrorInit {
  provider: ProviderName;
  /** HTTP status, or null when no response was received (network, timeout, bad input). */
  status?: number | null;
  /** The provider's short error status, e.g. `RESOURCE_EXHAUSTED`. */
  providerCode?: string | null;
  /** The provider's machine-readable reason, e.g. `API_KEY_INVALID`. */
  providerReason?: string | null;
  /** How long the provider asked us to wait, if it said. */
  retryAfterMs?: number | null;
}

export class ProviderError extends Error {
  readonly provider: ProviderName;
  readonly status: number | null;
  readonly providerCode: string | null;
  readonly providerReason: string | null;
  readonly retryAfterMs: number | null;

  constructor(message: string, init: ProviderErrorInit) {
    super(message);
    this.name = "ProviderError";
    this.provider = init.provider;
    this.status = init.status ?? null;
    this.providerCode = init.providerCode ?? null;
    this.providerReason = init.providerReason ?? null;
    this.retryAfterMs = init.retryAfterMs ?? null;
  }
}

/** HTTP 429: quota or rate limit exhausted. */
export class RateLimitError extends ProviderError {
  constructor(message: string, init: ProviderErrorInit) {
    super(message, init);
    this.name = "RateLimitError";
  }
}

/** 5xx, network failure, timeout, or a response we cannot trust (malformed). */
export class ProviderUnavailableError extends ProviderError {
  constructor(message: string, init: ProviderErrorInit) {
    super(message, init);
    this.name = "ProviderUnavailableError";
  }
}

/**
 * The request was rejected (4xx other than 429) or failed local validation.
 * Authentication and configuration failures (401/403, invalid API key) are
 * also reported here with `status`, `providerCode` and `providerReason`
 * preserved; use `isAuthError` to tell them apart from ordinary bad requests.
 */
export class BadRequestError extends ProviderError {
  constructor(message: string, init: ProviderErrorInit) {
    super(message, init);
    this.name = "BadRequestError";
  }

  get isAuthError(): boolean {
    return (
      this.status === 401 ||
      this.status === 403 ||
      this.providerReason === "API_KEY_INVALID"
    );
  }
}

/** Maps a non-success HTTP status to one of the three normalized errors. */
export function providerErrorFromStatus(
  init: ProviderErrorInit & { status: number },
): ProviderError {
  const label = PROVIDER_LABEL[init.provider];
  const detail = [`HTTP ${init.status}`, init.providerCode ?? null]
    .filter((part): part is string => part !== null)
    .join(", ");
  const message = `${label} request failed (${detail})`;

  if (init.status === 429) return new RateLimitError(message, init);
  if (init.status === 408 || init.status >= 500 || init.status < 400) {
    return new ProviderUnavailableError(message, init);
  }
  return new BadRequestError(message, init);
}

/** For failures that are our own or the provider's malformed output. */
export function unavailable(
  provider: ProviderName,
  what: string,
  status: number | null = null,
): ProviderUnavailableError {
  return new ProviderUnavailableError(`${PROVIDER_LABEL[provider]}: ${what}`, {
    provider,
    status,
  });
}

/** For input rejected locally, before any network call. */
export function badRequest(
  provider: ProviderName,
  what: string,
): BadRequestError {
  return new BadRequestError(`${PROVIDER_LABEL[provider]}: ${what}`, {
    provider,
    status: null,
  });
}
</file>

<file path="lib/providers/gemini-embedding.ts">
import "server-only";
import { badRequest, unavailable, type ProviderName } from "./errors";
import { geminiApiKey } from "./env";
import { getArray, isRecord } from "./guards";
import { DEFAULT_RETRY_POLICY, postWithRetry, type RetryPolicy } from "./http";
import type { EmbeddingProvider, EmbedRole } from "./types";

const PROVIDER: ProviderName = "gemini";
const BASE_URL = "https://generativelanguage.googleapis.com/v1beta";

/** Decided in Task 0.5 (docs/decisions.md, 2026-10-31). */
export const GEMINI_EMBEDDING_MODEL = "gemini-embedding-2";
/** Matches `vector(768)` in the schema. */
export const EMBEDDING_DIMENSIONS = 768;
/** Gemini's `batchEmbedContents` limit. Pacing across calls is the caller's job. */
export const MAX_EMBED_TEXTS_PER_CALL = 100;

const DOCUMENT_PREFIX = "title: none | text: ";
const QUERY_PREFIX = "task: search result | query: ";

/**
 * `gemini-embedding-2` does not take `taskType`; the role is signalled by a
 * text prefix instead. Using the wrong or a missing prefix silently changes
 * the vectors, so only the adapter applies it.
 */
export function formatEmbeddingInput(text: string, role: EmbedRole): string {
  return `${role === "query" ? QUERY_PREFIX : DOCUMENT_PREFIX}${text}`;
}

export interface GeminiEmbeddingOptions {
  retryPolicy?: RetryPolicy;
  timeoutMs?: number;
}

function validateInputs(texts: readonly string[]): void {
  if (texts.length > MAX_EMBED_TEXTS_PER_CALL) {
    throw badRequest(
      PROVIDER,
      `at most ${MAX_EMBED_TEXTS_PER_CALL} texts can be embedded per call`,
    );
  }
  texts.forEach((text, index) => {
    if (typeof text !== "string" || text.trim() === "") {
      throw badRequest(PROVIDER, `text at index ${index} is empty`);
    }
    // Callers pass raw text. Already-prefixed input would be prefixed twice.
    if (text.startsWith(DOCUMENT_PREFIX) || text.startsWith(QUERY_PREFIX)) {
      throw badRequest(
        PROVIDER,
        `text at index ${index} already has an embedding prefix; pass raw text`,
      );
    }
  });
}

function parseVectors(json: unknown, expectedCount: number): number[][] {
  if (!isRecord(json) || !Array.isArray(json.embeddings)) {
    throw unavailable(PROVIDER, "embedding response had no embeddings list");
  }
  const embeddings = getArray(json.embeddings);
  if (embeddings.length !== expectedCount) {
    throw unavailable(
      PROVIDER,
      `expected ${expectedCount} vectors but received ${embeddings.length}`,
    );
  }
  return embeddings.map((item, index) => {
    const values = isRecord(item) ? item.values : undefined;
    if (!Array.isArray(values)) {
      throw unavailable(PROVIDER, `vector ${index} was missing`);
    }
    if (values.length !== EMBEDDING_DIMENSIONS) {
      throw unavailable(
        PROVIDER,
        `vector ${index} had ${values.length} dimensions, expected ${EMBEDDING_DIMENSIONS}`,
      );
    }
    const vector: number[] = [];
    for (const value of values as unknown[]) {
      if (typeof value !== "number" || !Number.isFinite(value)) {
        throw unavailable(PROVIDER, `vector ${index} had a non-numeric value`);
      }
      vector.push(value);
    }
    return vector;
  });
}

export function createGeminiEmbeddingProvider(
  options: GeminiEmbeddingOptions = {},
): EmbeddingProvider {
  const policy = options.retryPolicy ?? DEFAULT_RETRY_POLICY;
  const timeoutMs = options.timeoutMs ?? 60_000;

  return {
    model: GEMINI_EMBEDDING_MODEL,
    dimensions: EMBEDDING_DIMENSIONS,
    async embed(texts, role) {
      validateInputs(texts);
      if (texts.length === 0) return [];

      // One `requests[]` entry per text, so each text gets its own vector.
      const body = {
        requests: texts.map((text) => ({
          model: `models/${GEMINI_EMBEDDING_MODEL}`,
          content: { parts: [{ text: formatEmbeddingInput(text, role) }] },
          outputDimensionality: EMBEDDING_DIMENSIONS,
        })),
      };

      const response = await postWithRetry({
        provider: PROVIDER,
        url: `${BASE_URL}/models/${GEMINI_EMBEDDING_MODEL}:batchEmbedContents`,
        // The key travels in a header, never the URL, so it cannot be logged with one.
        headers: {
          "x-goog-api-key": geminiApiKey(),
          "content-type": "application/json",
        },
        body: JSON.stringify(body),
        timeoutMs,
        policy,
      });

      let json: unknown;
      try {
        json = await response.json();
      } catch {
        throw unavailable(PROVIDER, "embedding response was not valid JSON");
      }
      return parseVectors(json, texts.length);
    },
  };
}
</file>

<file path="lib/providers/gemini-llm.ts">
import "server-only";
import {
  badRequest,
  ProviderError,
  providerErrorFromStatus,
  unavailable,
  type ProviderName,
} from "./errors";
import { geminiApiKey, optionalEnv } from "./env";
import {
  getArray,
  getNumber,
  getString,
  isRecord,
  type JsonRecord,
} from "./guards";
import {
  DEFAULT_RETRY_POLICY,
  describeNetworkError,
  postWithRetry,
  type RetryPolicy,
} from "./http";
import { readSseData } from "./sse";
import type {
  LlmFinishReason,
  LlmMessage,
  LlmProvider,
  LlmStreamEvent,
  LlmUsage,
} from "./types";

const PROVIDER: ProviderName = "gemini";
const BASE_URL = "https://generativelanguage.googleapis.com/v1beta";

/**
 * PROVISIONAL default. `gemini-3.5-flash-lite` is the model the Task 0.5 spike
 * streamed successfully (one RAG prompt, local and deployed), and the console
 * showed 500 requests/day for it. docs/spikes/provider.md calls the LLM choice
 * provisional and Slice 2's eval is meant to compare candidates, so this is a
 * starting point, not an architectural decision. Override with the `model`
 * option or the `GEMINI_LLM_MODEL` environment variable.
 */
export const DEFAULT_GEMINI_LLM_MODEL = "gemini-3.5-flash-lite";

/** The id goes into a URL path, so it is restricted to a safe character set. */
const MODEL_ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$/;

export interface GeminiLlmOptions {
  /** Takes precedence over `GEMINI_LLM_MODEL`, which takes precedence over the default. */
  model?: string;
  retryPolicy?: RetryPolicy;
  timeoutMs?: number;
}

// ---------------------------------------------------------------- request

interface GeminiContent {
  role: "user" | "model";
  parts: { text: string }[];
}

function buildRequestBody(
  messages: readonly LlmMessage[],
  maxOutputTokens: number | undefined,
): string {
  const system: string[] = [];
  const contents: GeminiContent[] = [];

  for (const message of messages) {
    if (typeof message.content !== "string" || message.content.trim() === "") {
      throw badRequest(PROVIDER, "a message had no content");
    }
    if (message.role === "system") system.push(message.content);
    else {
      contents.push({
        role: message.role === "assistant" ? "model" : "user",
        parts: [{ text: message.content }],
      });
    }
  }
  if (contents.length === 0) {
    throw badRequest(
      PROVIDER,
      "at least one user or assistant message is required",
    );
  }
  if (
    maxOutputTokens !== undefined &&
    (!Number.isInteger(maxOutputTokens) || maxOutputTokens < 1)
  ) {
    throw badRequest(PROVIDER, "maxOutputTokens must be a positive integer");
  }

  return JSON.stringify({
    ...(system.length > 0
      ? { systemInstruction: { parts: [{ text: system.join("\n\n") }] } }
      : {}),
    contents,
    ...(maxOutputTokens !== undefined
      ? { generationConfig: { maxOutputTokens } }
      : {}),
  });
}

// --------------------------------------------------------------- response

const BLOCKED_FINISH_REASONS = new Set([
  "SAFETY",
  "RECITATION",
  "BLOCKLIST",
  "PROHIBITED_CONTENT",
  "SPII",
]);

function normalizeFinishReason(reason: string): LlmFinishReason {
  if (reason === "STOP") return "stop";
  if (reason === "MAX_TOKENS") return "length";
  if (BLOCKED_FINISH_REASONS.has(reason)) return "blocked";
  return "other";
}

interface ParsedChunk {
  texts: string[];
  finishReason: string | null;
  promptBlocked: boolean;
  usage: LlmUsage | null;
}

function parseChunk(data: string): ParsedChunk {
  let json: unknown;
  try {
    json = JSON.parse(data);
  } catch {
    throw unavailable(
      PROVIDER,
      "stream contained a chunk that was not valid JSON",
    );
  }
  if (!isRecord(json)) {
    throw unavailable(PROVIDER, "stream contained an unexpected chunk");
  }
  throwIfErrorChunk(json);

  const texts: string[] = [];
  let finishReason: string | null = null;
  const candidate = getArray(json.candidates)[0];
  if (isRecord(candidate)) {
    const content = isRecord(candidate.content) ? candidate.content : null;
    for (const part of content ? getArray(content.parts) : []) {
      if (!isRecord(part)) continue;
      const text = getString(part.text);
      // Reasoning ("thought") parts are not part of the answer.
      if (text === null || text === "" || part.thought === true) continue;
      texts.push(text);
    }
    finishReason = getString(candidate.finishReason);
  }

  const feedback = isRecord(json.promptFeedback) ? json.promptFeedback : null;
  const promptBlocked =
    feedback !== null && getString(feedback.blockReason) !== null;

  const usageMetadata = isRecord(json.usageMetadata)
    ? json.usageMetadata
    : null;
  const usage: LlmUsage | null = usageMetadata
    ? {
        promptTokens: getNumber(usageMetadata.promptTokenCount),
        completionTokens: getNumber(usageMetadata.candidatesTokenCount),
      }
    : null;

  return { texts, finishReason, promptBlocked, usage };
}

/** An error object can arrive inside a 200 stream. Map it like an HTTP error. */
function throwIfErrorChunk(json: JsonRecord): void {
  if (!isRecord(json.error)) return;
  const code = getNumber(json.error.code);
  const status = getString(json.error.status);
  if (code === null || code < 400) {
    throw unavailable(PROVIDER, "stream reported an error");
  }
  throw providerErrorFromStatus({
    provider: PROVIDER,
    status: code,
    providerCode:
      status !== null && /^[A-Za-z0-9_.-]{1,64}$/.test(status) ? status : null,
  });
}

async function* parseStream(
  body: ReadableStream<Uint8Array>,
  callerSignal: AbortSignal | undefined,
): AsyncGenerator<LlmStreamEvent> {
  let finishReason: string | null = null;
  let promptBlocked = false;
  let usage: LlmUsage | null = null;

  try {
    for await (const data of readSseData(body)) {
      const chunk = parseChunk(data);
      for (const text of chunk.texts) yield { type: "text", text };
      finishReason = chunk.finishReason ?? finishReason;
      promptBlocked = promptBlocked || chunk.promptBlocked;
      usage = chunk.usage ?? usage;
    }
  } catch (error) {
    if (error instanceof ProviderError) throw error;
    if (callerSignal?.aborted) throw error;
    throw unavailable(
      PROVIDER,
      `stream interrupted: ${describeNetworkError(error)}`,
    );
  }

  if (finishReason === null && !promptBlocked) {
    // A silent cut-off must not look like a complete answer.
    throw unavailable(PROVIDER, "stream ended without a finish reason");
  }
  yield {
    type: "finish",
    reason: promptBlocked
      ? "blocked"
      : normalizeFinishReason(finishReason ?? ""),
    ...(usage ? { usage } : {}),
  };
}

// ---------------------------------------------------------------- factory

export function createGeminiLlmProvider(
  options: GeminiLlmOptions = {},
): LlmProvider {
  const model =
    options.model ??
    optionalEnv("GEMINI_LLM_MODEL") ??
    DEFAULT_GEMINI_LLM_MODEL;
  if (!MODEL_ID.test(model)) {
    throw new Error(
      "Invalid Gemini LLM model id (option or GEMINI_LLM_MODEL).",
    );
  }
  const policy = options.retryPolicy ?? DEFAULT_RETRY_POLICY;
  const timeoutMs = options.timeoutMs ?? 90_000;

  return {
    model,
    async *stream(messages, streamOptions = {}) {
      const body = buildRequestBody(messages, streamOptions.maxOutputTokens);
      const response = await postWithRetry({
        provider: PROVIDER,
        url: `${BASE_URL}/models/${model}:streamGenerateContent?alt=sse`,
        headers: {
          "x-goog-api-key": geminiApiKey(),
          "content-type": "application/json",
        },
        body,
        timeoutMs,
        policy,
        signal: streamOptions.signal,
      });
      if (!response.body) {
        throw unavailable(PROVIDER, "streaming response had no body");
      }
      yield* parseStream(response.body, streamOptions.signal);
    },
  };
}
</file>

