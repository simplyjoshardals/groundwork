import type { SupabaseClient } from "@supabase/supabase-js";
import { isUuid } from "@/lib/viewer-url/location";
import type { Database } from "@/types/database";

/**
 * Resolves `?doc=<id>` to what the viewer needs (Task 3.3). No `server-only`
 * on purpose: the browser calls it with its own session. Pass a user-scoped
 * client, never the admin client: the `documents_select` policy (own or
 * public) decides what comes back, so another user's id is indistinguishable
 * from a missing one.
 */

export interface ViewerDocument {
  id: string;
  title: string;
  storagePath: string;
  mimeType: string;
}

export type ViewerDocumentResult =
  | { ok: true; document: ViewerDocument }
  /** Missing, or not readable by this session (the database does not say which). */
  | { ok: false; reason: "not_found" }
  /** Network or database error; worth a retry. */
  | { ok: false; reason: "failed" };

export async function getViewerDocument(
  client: SupabaseClient<Database>,
  documentId: string,
): Promise<ViewerDocumentResult> {
  // Never send a malformed id to the database.
  if (!isUuid(documentId)) return { ok: false, reason: "not_found" };

  const { data, error } = await client
    .from("documents")
    .select("id, title, storage_path, mime_type")
    .eq("id", documentId)
    .maybeSingle();

  if (error) return { ok: false, reason: "failed" };
  if (!data) return { ok: false, reason: "not_found" };

  return {
    ok: true,
    document: {
      id: data.id,
      title: data.title,
      storagePath: data.storage_path,
      mimeType: data.mime_type,
    },
  };
}
</file>

<file path="lib/pdf-highlight/use-chunk-passage.ts">
"use client";

import { useEffect, useState } from "react";
import { getChunk, type ChunkPassage, type ChunkResult } from "@/lib/documents/get-chunk";
import { createBrowserSupabase } from "@/lib/supabase/browser";

export type ChunkPassageState =
  /** The link names no chunk. */
  | { state: "none" }
  | { state: "loading" }
  | { state: "ready"; chunk: ChunkPassage }
  /** Missing, or not readable by this session (the database does not say which). */
  | { state: "unavailable" }
  /** Network or database error; worth a retry. */
  | { state: "error" };

/** Loads the chunk with the browser (user) session; never throws. */
async function loadChunk(chunkId: string): Promise<ChunkResult> {
  try {
    return await getChunk(createBrowserSupabase(), chunkId);
  } catch (error) {
    // Name only: messages could carry configuration details.
    console.error(
      "[viewer-panel] chunk lookup failed:",
      error instanceof Error ? error.name : "unknown",
    );
    return { ok: false, reason: "failed" };
  }
}

/**
 * Resolves `?chunk=<id>` to the cited passage (Task 3.5). Results are keyed by
 * chunk id and retry attempt, so a late answer for an earlier chunk can never
 * be shown for the current one. Pass `null` for no lookup (no chunk in the
 * link, or a document that is not a PDF).
 */
export function useChunkPassage(chunkId: string | null): {
  state: ChunkPassageState;
  retry: () => void;
} {
  const [attempt, setAttempt] = useState(0);
  const [settled, setSettled] = useState<{
    key: string;
    result: ChunkResult;
  } | null>(null);
  const key = chunkId === null ? null : `${chunkId}#${attempt}`;

  useEffect(() => {
    if (key === null || chunkId === null) return;
    let cancelled = false;
    void loadChunk(chunkId).then((result) => {
      if (!cancelled) setSettled({ key, result });
    });
    return () => {
      cancelled = true;
    };
  }, [key, chunkId]);

  let state: ChunkPassageState;
  if (key === null) {
    state = { state: "none" };
  } else if (settled === null || settled.key !== key) {
    state = { state: "loading" };
  } else if (settled.result.ok) {
    state = { state: "ready", chunk: settled.result.chunk };
  } else if (settled.result.reason === "not_found") {
    state = { state: "unavailable" };
  } else {
    state = { state: "error" };
  }
  return { state, retry: () => setAttempt((count) => count + 1) };
}
</file>

<file path="lib/storage/documents.ts">
import type { SupabaseClient } from "@supabase/supabase-js";
import type { Database } from "@/types/database";

/**
 * Signed URLs for files in the private `documents` bucket (Task 3.1).
 *
 * No `server-only` marker on purpose: ARCHITECTURE Flow 3 has the browser ask
 * for the URL, so this runs with either the browser or the server-as-user
 * client. Never pass the admin client here, because the service role bypasses
 * the storage policies this helper relies on. Access is decided by the
 * `documents_objects_select` policy (migration 0007), not by this code; the
 * checks below only stop malformed paths from being sent at all.
 */

/** Storage bucket created by migration 0007 (DATA_MODEL 2.7). */
export const DOCUMENTS_BUCKET = "documents";

/**
 * Short on purpose. PDF.js may fetch byte ranges lazily, so a very short life
 * could break page navigation in a long session; Task 3.2 should request a
 * fresh URL if a range request fails.
 */
export const DEFAULT_SIGNED_URL_TTL_SECONDS = 900;
export const MAX_SIGNED_URL_TTL_SECONDS = 3600;

const UUID = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
const FILE_NAME = "[A-Za-z0-9._-]{1,100}";

/** Same two shapes as the `documents_storage_path_shape` constraint (DATA_MODEL 2.3). */
const STORAGE_PATH_PATTERN = new RegExp(
  `^(?:samples/${FILE_NAME}|${UUID}/${UUID}/${FILE_NAME})$`,
);

/**
 * True when `value` has the shape of a document storage path. Stricter than
 * the database constraint in one way: a file name made only of dots (`.`,
 * `..`) is rejected, so a path can never be read as a traversal.
 */
export function isDocumentStoragePath(value: string): boolean {
  if (!STORAGE_PATH_PATTERN.test(value)) return false;
  const fileName = value.slice(value.lastIndexOf("/") + 1);
  return !/^\.+$/.test(fileName);
}

export type SignedUrlFailureReason =
  | "invalid_path" // malformed; no request was sent
  | "not_found" // missing, or not readable by this session (storage does not say which)
  | "failed"; // network or storage error; worth a retry

export type SignedUrlResult =
  | { ok: true; url: string; expiresAt: Date }
  | { ok: false; reason: SignedUrlFailureReason; message: string };

/**
 * The slice of the Supabase client this helper uses. Real clients satisfy it,
 * and tests can pass a small fake without casts.
 */
export interface SignedUrlClient {
  storage: {
    from(bucket: string): {
      createSignedUrl(
        path: string,
        expiresIn: number,
      ): Promise<{
        data: { signedUrl: string } | null;
        error: { message: string; status?: number } | null;
      }>;
    };
  };
}

// Compile-time proof that the real client fits the narrow interface.
type _RealClientFits =
  SupabaseClient<Database> extends SignedUrlClient ? true : never;
const _realClientFits: _RealClientFits = true;
void _realClientFits;

export interface SignedUrlOptions {
  /** Lifetime in whole seconds, 1 to MAX_SIGNED_URL_TTL_SECONDS. */
  expiresIn?: number;
}

/**
 * Asks Storage for a signed URL for one document file, using the session the
 * client carries. Storage answers "not found" both for a missing object and
 * for one the policy hides, so another user's path looks exactly like a
 * missing one (no existence leak).
 *
 * Expected failures come back as `{ ok: false }` so callers must handle them.
 * A bad `expiresIn` is a programming error and throws `RangeError`.
 * The returned URL is a bearer credential: do not log it.
 */
export async function createDocumentSignedUrl(
  client: SignedUrlClient,
  storagePath: string,
  options: SignedUrlOptions = {},
): Promise<SignedUrlResult> {
  const expiresIn = options.expiresIn ?? DEFAULT_SIGNED_URL_TTL_SECONDS;
  if (
    !Number.isInteger(expiresIn) ||
    expiresIn < 1 ||
    expiresIn > MAX_SIGNED_URL_TTL_SECONDS
  ) {
    throw new RangeError(
      `expiresIn must be a whole number from 1 to ${MAX_SIGNED_URL_TTL_SECONDS} seconds`,
    );
  }

  if (!isDocumentStoragePath(storagePath)) {
    return {
      ok: false,
      reason: "invalid_path",
      message: "Not a valid document storage path.",
    };
  }

  const issuedAt = Date.now();
  let response: Awaited<
    ReturnType<
      ReturnType<SignedUrlClient["storage"]["from"]>["createSignedUrl"]
    >
  >;
  try {
    response = await client.storage
      .from(DOCUMENTS_BUCKET)
      .createSignedUrl(storagePath, expiresIn);
  } catch (error) {
    return {
      ok: false,
      reason: "failed",
      message: error instanceof Error ? error.message : "Request failed.",
    };
  }

  const { data, error } = response;
  if (error) {
    const notFound =
      error.status === 400 ||
      error.status === 404 ||
      /not found/i.test(error.message);
    return {
      ok: false,
      reason: notFound ? "not_found" : "failed",
      message: error.message,
    };
  }
  if (!data?.signedUrl) {
    return {
      ok: false,
      reason: "failed",
      message: "Storage returned no signed URL.",
    };
  }

  return {
    ok: true,
    url: data.signedUrl,
    expiresAt: new Date(issuedAt + expiresIn * 1000),
  };
}
</file>

<file path="lib/supabase/browser.ts">
import { createBrowserClient } from "@supabase/ssr";
import type { SupabaseClient } from "@supabase/supabase-js";
import type { Database } from "@/types/database";
import { supabasePublishableKey, supabaseUrl } from "./env";

/**
 * Browser client: publishable key only, so every query is subject to RLS.
 * Session cookies are read and written by `@supabase/ssr`; the root
 * `proxy.ts` keeps them fresh. In the browser `createBrowserClient` returns a
 * singleton, so calling this per interaction is cheap.
 */
export function createBrowserSupabase(): SupabaseClient<Database> {
  return createBrowserClient<Database>(supabaseUrl(), supabasePublishableKey());
}
