Date: Tue, 17 Nov 2026 22:21:31 +0000
Subject: [PATCH] fix(u5): lint purity errors in drill page and toast; correct
 toast and upload-panel tests

---
 app/dev-states/documents/[scenario]/page.tsx |  3 ++-
 components/ui/toast.tsx                      | 16 ++++++++--------
 lib/documents/dev-scenario-names.ts          |  5 +++++
 tests/unit/toast.test.tsx                    |  6 ++++--
 tests/unit/upload-panel.test.tsx             |  6 +++++-
 5 files changed, 24 insertions(+), 12 deletions(-)

diff --git a/app/dev-states/documents/[scenario]/page.tsx b/app/dev-states/documents/[scenario]/page.tsx
index 2168f89..fb09a43 100644
--- a/app/dev-states/documents/[scenario]/page.tsx
+++ b/app/dev-states/documents/[scenario]/page.tsx
@@ -2,6 +2,7 @@ import { notFound } from "next/navigation";
 import { DocumentsDrill } from "@/components/dev/documents-drill";
 import {
   DOC_SCENARIO_NOTES,
+  drillNowMs,
   isDocScenario,
 } from "@/lib/documents/dev-scenario-names";
 
@@ -22,7 +23,7 @@ export default async function DocumentsDrillPage({
       <p className="text-sm text-muted text-pretty">
         <span className="font-mono">{scenario}</span>: {DOC_SCENARIO_NOTES[scenario]}
       </p>
-      <DocumentsDrill scenario={scenario} now={Date.now()} />
+      <DocumentsDrill scenario={scenario} now={drillNowMs()} />
     </main>
   );
 }
diff --git a/components/ui/toast.tsx b/components/ui/toast.tsx
index d51aa66..ec6367e 100644
--- a/components/ui/toast.tsx
+++ b/components/ui/toast.tsx
@@ -90,18 +90,18 @@ export function ToastProvider({ children }: { children: ReactNode }) {
 }
 
 const NOOP_TOAST: ToastApi = { show: () => undefined };
-let warnedMissingProvider = false;
 
 /**
  * Without a provider (a component rendered on its own in a test) this is a
- * no-op, with one development warning, so an isolated render still works.
+ * no-op, with a development warning, so an isolated render still works.
  */
 export function useToast(): ToastApi {
   const api = useContext(ToastContext);
-  if (api) return api;
-  if (process.env.NODE_ENV !== "production" && !warnedMissingProvider) {
-    warnedMissingProvider = true;
-    console.warn("[toast] useToast was used outside a ToastProvider.");
-  }
-  return NOOP_TOAST;
+  const missing = api === null;
+  useEffect(() => {
+    if (missing && process.env.NODE_ENV !== "production") {
+      console.warn("[toast] useToast was used outside a ToastProvider.");
+    }
+  }, [missing]);
+  return api ?? NOOP_TOAST;
 }
diff --git a/lib/documents/dev-scenario-names.ts b/lib/documents/dev-scenario-names.ts
index 2c1b057..0f5775c 100644
--- a/lib/documents/dev-scenario-names.ts
+++ b/lib/documents/dev-scenario-names.ts
@@ -46,6 +46,11 @@ export const DOC_SCENARIO_NOTES: Readonly<Record<DocScenario, string>> = {
   "session-ended": "Delete always answers that the session has ended.",
 };
 
+/** The server clock for a drill page. A function, so the page itself stays pure. */
+export function drillNowMs(): number {
+  return Date.now();
+}
+
 export function isDocScenario(value: string): value is DocScenario {
   return (DOC_SCENARIOS as readonly string[]).includes(value);
 }
