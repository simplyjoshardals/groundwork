@@ -0,0 +1,40 @@
+import type { ChunkResult } from "@/lib/documents/get-chunk";
+import type { ViewerDocumentResult } from "@/lib/documents/get-viewer-document";
+import {
+  createDocumentSignedUrl,
+  type SignedUrlResult,
+} from "@/lib/storage/documents";
+import { createBrowserSupabase } from "@/lib/supabase/browser";
+import {
+  loadTextFile,
+  type TextFileResult,
+} from "@/lib/text-viewer/load-text-file";
+import { loadChunkPassage, loadViewerDocument } from "@/lib/viewer-prefetch";
+
+/**
+ * Everything the viewer reads from outside: one small seam, so the dev drill
+ * (`/dev-states/viewer/<scenario>`) can run the real viewer against scripted
+ * answers (errors, slow responses, declined highlights) with no backend.
+ * Members are plain function properties, not methods, so they can be passed
+ * around unbound. Callers wrap every call in try/catch: a source may reject.
+ */
+export interface ViewerSource {
+  loadDocument: (documentId: string) => Promise<ViewerDocumentResult>;
+  loadChunk: (chunkId: string) => Promise<ChunkResult>;
+  /** A URL PDF.js can fetch for a stored file. */
+  createPdfUrl: (storagePath: string) => Promise<SignedUrlResult>;
+  loadText: (
+    storagePath: string,
+    signal: AbortSignal,
+  ) => Promise<TextFileResult>;
+}
+
+/** The real backend: the browser (user) session, through the 60 s prefetch cache. */
+export const realViewerSource: ViewerSource = {
+  loadDocument: (documentId) => loadViewerDocument(documentId),
+  loadChunk: (chunkId) => loadChunkPassage(chunkId),
+  createPdfUrl: (storagePath) =>
+    createDocumentSignedUrl(createBrowserSupabase(), storagePath),
+  loadText: (storagePath, signal) =>
+    loadTextFile(createBrowserSupabase(), storagePath, { signal }),
+};
diff --git a/lib/viewer/use-highlight-reveal.ts b/lib/viewer/use-highlight-reveal.ts
new file mode 100644
index 0000000..82368eb
--- /dev/null
+++ b/lib/viewer/use-highlight-reveal.ts
@@ -0,0 +1,74 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { scrollToPassage } from "./scroll-to-passage";
+import { WIPE_DONE_AFTER_MS, WIPE_SAFETY_MS, staggerDelays } from "./wipe";
+
+/** What `data-wipe` on the paper sheet says: `pending` hides, `play` animates. */
+export type WipePhase = "pending" | "play";
+
+/**
+ * The highlight wipe (DESIGN 7): the cited passage is drawn hidden, the page
+ * scrolls to it, and once the scroll has settled the highlight grows once from
+ * left to right. `activeKey` names the highlight currently drawn (`null` when
+ * there is none); the same key never wipes twice, so a resize that redraws the
+ * text layer does not replay it. `phase` goes on the paper sheet as
+ * `data-wipe`; `undefined` means "just show it".
+ *
+ * Safety net: a highlight is never left hidden. If `reveal` does not report
+ * back, the wipe starts after `WIPE_SAFETY_MS` anyway.
+ */
+export function useHighlightReveal(activeKey: string | null): {
+  phase: WipePhase | undefined;
+  /** Call with the drawn `mark` elements, in reading order, once they exist. */
+  reveal: (marks: readonly HTMLElement[], key: string) => Promise<void>;
+} {
+  const [played, setPlayed] = useState<string | null>(null);
+  const [finished, setFinished] = useState<string | null>(null);
+  const aliveRef = useRef(true);
+  const activeRef = useRef(activeKey);
+
+  useEffect(() => {
+    aliveRef.current = true;
+    return () => {
+      aliveRef.current = false;
+    };
+  }, []);
+
+  useEffect(() => {
+    activeRef.current = activeKey;
+  }, [activeKey]);
+
+  useEffect(() => {
+    if (played === null) return;
+    const timer = setTimeout(() => setFinished(played), WIPE_DONE_AFTER_MS);
+    return () => clearTimeout(timer);
+  }, [played]);
+
+  useEffect(() => {
+    if (activeKey === null) return;
+    const timer = setTimeout(
+      () => setPlayed((current) => (current === activeKey ? current : activeKey)),
+      WIPE_SAFETY_MS,
+    );
+    return () => clearTimeout(timer);
+  }, [activeKey]);
+
+  const reveal = useCallback(
+    async (marks: readonly HTMLElement[], key: string) => {
+      if (marks.length === 0) return;
+      staggerDelays(marks.length).forEach((delay, index) => {
+        marks[index]?.style.setProperty("--wipe-delay", `${delay}ms`);
+      });
+      await scrollToPassage(marks);
+      if (aliveRef.current && activeRef.current === key) setPlayed(key);
+    },
+    [],
+  );
+
+  let phase: WipePhase | undefined;
+  if (activeKey !== null && finished !== activeKey) {
+    phase = played === activeKey ? "play" : "pending";
+  }
+  return { phase, reveal };
+}
diff --git a/lib/viewer/use-is-docked.ts b/lib/viewer/use-is-docked.ts
new file mode 100644
index 0000000..a428fcf
--- /dev/null
+++ b/lib/viewer/use-is-docked.ts
@@ -0,0 +1,25 @@
+"use client";
+
+import { useSyncExternalStore } from "react";
+
+/** Tailwind's `xl`. From here the viewer is docked in the right column (DESIGN 4.3). */
+const DOCKED_QUERY = "(min-width: 80rem)";
+
+function subscribe(onChange: () => void): () => void {
+  const query = window.matchMedia(DOCKED_QUERY);
+  query.addEventListener("change", onChange);
+  return () => query.removeEventListener("change", onChange);
+}
+
+/**
+ * True when the viewer is a docked panel, false when it is a sheet. The server
+ * snapshot is `false` (sheet): a closed `<dialog>` draws nothing, so a phone
+ * never flashes a docked panel before hydration.
+ */
+export function useIsDocked(): boolean {
+  return useSyncExternalStore(
+    subscribe,
+    () => window.matchMedia(DOCKED_QUERY).matches,
+    () => false,
+  );
+}
