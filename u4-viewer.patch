new file mode 100644
index 0000000..db9accc
--- /dev/null
+++ b/lib/viewer/use-restore-focus.ts
@@ -0,0 +1,45 @@
+"use client";
+
+import { useCallback, useEffect, useRef } from "react";
+
+/** Marker and card buttons carry `data-citation-chunk="<chunk id>"`. */
+export const CITATION_CHUNK_ATTRIBUTE = "data-citation-chunk";
+
+function findCitation(chunkId: string | null): HTMLElement | null {
+  // Digits only: the id goes into a selector.
+  if (chunkId === null || !/^\d+$/.test(chunkId)) return null;
+  return document.querySelector<HTMLElement>(
+    `[${CITATION_CHUNK_ATTRIBUTE}="${chunkId}"]`,
+  );
+}
+
+/**
+ * Gives focus back to the citation that opened the viewer once it closes
+ * (DESIGN 4.3). Call the returned function with the button and its chunk id
+ * when a citation is opened. If that button is gone by then (the answer was
+ * asked again, a list re-rendered), focus goes to the marker or card for the
+ * same chunk instead, and to nothing if there is none.
+ */
+export function useRestoreFocus(
+  open: boolean,
+): (trigger: HTMLElement, chunkId: string | null) => void {
+  const triggerRef = useRef<{ element: HTMLElement; chunkId: string | null } | null>(
+    null,
+  );
+  const wasOpenRef = useRef(false);
+
+  useEffect(() => {
+    const trigger = triggerRef.current;
+    if (wasOpenRef.current && !open && trigger !== null) {
+      const target = trigger.element.isConnected
+        ? trigger.element
+        : findCitation(trigger.chunkId);
+      target?.focus();
+    }
+    wasOpenRef.current = open;
+  }, [open]);
+
+  return useCallback((element: HTMLElement, chunkId: string | null) => {
+    triggerRef.current = { element, chunkId };
+  }, []);
+}
diff --git a/lib/viewer/wipe.ts b/lib/viewer/wipe.ts
new file mode 100644
index 0000000..fef70d1
--- /dev/null
+++ b/lib/viewer/wipe.ts
@@ -0,0 +1,22 @@
+/**
+ * Timing of the highlight wipe (DESIGN 7). Pure, so it runs under the
+ * node-only Vitest setup. The CSS owns the animation itself (`--dur-highlight`);
+ * these numbers only decide when to start it and when it is certainly over.
+ */
+
+export const WIPE_MS = 600;
+/** A passage that wraps over several lines wipes one line after another. */
+export const STAGGER_STEP_MS = 80;
+export const STAGGER_CAP_MS = 400;
+/** After this the wipe has surely finished, so a re-render never replays it. */
+export const WIPE_DONE_AFTER_MS = WIPE_MS + STAGGER_CAP_MS + 200;
+/** If the scroll never reports back, start the wipe anyway: never hide a highlight. */
+export const WIPE_SAFETY_MS = 2500;
+
+/** Start delay for each of `count` highlight pieces, in reading order. */
+export function staggerDelays(count: number): number[] {
+  if (count <= 0) return [];
+  if (count === 1) return [0];
+  const step = Math.min(STAGGER_STEP_MS, STAGGER_CAP_MS / (count - 1));
+  return Array.from({ length: count }, (_, index) => Math.round(index * step));
+}
